# Template for .env, never commit real values. The .env only lives on the server (/opt/trustylynx/vault-service/.env).
# Put values with $ in single quotes, otherwise Docker Compose treats the rest as a variable.

# Inside the Docker network: container name of the DB and its internal port, not localhost.
DB_URL=jdbc:postgresql://vault-db:7483/vault
DB_USER=vault_service
DB_PASSWORD=

# Key service (pepper-hmac) and the ChaCha crypto service (layer 2 for the wDEK and chacha items).
KEY_SERVICE_URL=https://key.nexvent.de
CRYPTO_SERVICE_URL=

# AES crypto service, only for items with alg = aes. Default: http://crypto-service-aes256gcm:8080
CRYPTO_AES_SERVICE_URL=

# Our service token for the key and ChaCha service, they know it as VAULT_SERVICE_TOKEN.
SERVICE_TOKEN_VAULT=''

# Token for the AES service, same value as AES_SERVICE_TOKEN there. Required, otherwise the service doesn't start.
SERVICE_TOKEN_AES=''

# For checking login tokens at the auth service (POST /internal/sessions/verify). It only knows the gateway token for that,
# so it's the same value as SERVICE_TOKEN_GATEWAY there. Required, otherwise the service doesn't start.
SERVICE_TOKEN_GATEWAY=''

# The breach service uses this one for POST /internal/vault/unlocked, same value as SERVICE_TOKEN_BREACH there.
# Required, otherwise the service doesn't start.
SERVICE_TOKEN_BREACH=''

# Optional, default: http://auth-service:8080 (container in trustylynx-net). Locally: http://localhost:7491
# AUTH_SERVICE_URL=http://auth-service:8080

# Optional: additional browser origins for CORS, comma separated. The website https://trustylynx.nexvent.de,
# http://localhost:<port> and http://127.0.0.1:<port> always work, so on the server this stays unset.
# CORS_ALLOWED_ORIGINS=https://staging.example.de

# Optional, default: false. Allows origin "null" (frontend opened as a file by double click).
# Local only, always false on the server: "null" can also come from sandboxed iframes of any website.
# CORS_ALLOW_NULL_ORIGIN=false
